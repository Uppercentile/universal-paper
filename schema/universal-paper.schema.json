{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-paper.example/schema/UP-0.1-draft/universal-paper.schema.json",
  "title": "Universal Paper UP/0.1-draft primitives",
  "description": "Machine-readable shapes of every Universal Paper object. Structural validity only: the axioms in spec/03-axioms.md decide whether a well-shaped object is valid.",
  "oneOf": [
    {"$ref": "#/$defs/Bundle"},
    {"$ref": "#/$defs/Agreement"},
    {"$ref": "#/$defs/Event"},
    {"$ref": "#/$defs/State"},
    {"$ref": "#/$defs/Mandate"},
    {"$ref": "#/$defs/TermDefinition"}
  ],
  "$defs": {
    "Spec": {"const": "UP/0.1-draft"},
    "Hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ChainId": {"$ref": "#/$defs/Hash"},
    "PublicKey": {"type": "string", "pattern": "^ed25519:[0-9a-f]{64}$"},
    "Time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "Decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "Rate": {"$ref": "#/$defs/Decimal"},
    "Amount": {"type": "object", "additionalProperties": false, "required": ["value", "currency"],
      "properties": {"value": {"$ref": "#/$defs/Decimal"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}},
    "Period": {"type": "object", "additionalProperties": false, "required": ["unit", "count"],
      "properties": {"unit": {"enum": ["day", "month", "quarter", "year"]}, "count": {"type": "integer", "minimum": 1}}},
    "Rounding": {"type": "object", "additionalProperties": false, "required": ["scale", "mode"],
      "properties": {"scale": {"type": "integer", "minimum": 0}, "mode": {"enum": ["half-even", "half-up", "down", "up"]}}},
    "Role": {"enum": ["aggregator", "supplier", "member"]},
    "Identifier": {"type": "object", "additionalProperties": false, "required": ["scheme", "id"],
      "properties": {"scheme": {"type": "string", "minLength": 1}, "id": {"oneOf": [{"type": "string"}, {"$ref": "#/$defs/Seal"}]}}},
    "ClaimType": {"type": "string", "pattern": "^UP:[A-Za-z0-9-]+/[a-z0-9-]+$"},
    "Seal": {"type": "object", "additionalProperties": false, "required": ["seal"], "properties": {"seal": {"$ref": "#/$defs/Hash"}}},
    "Disclosure": {"type": "object", "additionalProperties": false, "required": ["seal", "salt", "value"],
      "properties": {"seal": {"$ref": "#/$defs/Hash"}, "salt": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "value": {}}},
    "Signature": {"type": "object", "additionalProperties": false, "required": ["key"],
      "properties": {"key": {"$ref": "#/$defs/PublicKey"}, "sig": {"type": "string", "pattern": "^[0-9a-f]{128}$"}, "mandate": {"$ref": "#/$defs/Hash"}}},
    "Sigs": {"type": "array", "items": {"$ref": "#/$defs/Signature"}},
    "Party": {"type": "object", "additionalProperties": false, "required": ["key"],
      "properties": {"key": {"$ref": "#/$defs/PublicKey"}, "name": {"type": "string"},
        "ids": {"type": "array", "items": {"$ref": "#/$defs/Identifier"}}}},
    "FormRef": {"description": "A clause-form field: a literal structural value or a reference to a parameter.",
      "oneOf": [{"type": "object", "required": ["param"], "properties": {"param": {"type": "string"}}, "additionalProperties": false}, {}]},
    "ClauseForm": {"type": "object", "required": ["form"],
      "properties": {"form": {"enum": ["Window", "Exit", "Selection", "Valuation", "Duty", "Link"]}}},
    "TermDefinition": {"type": "object", "additionalProperties": false,
      "required": ["type", "spec", "id", "title", "params", "forms", "claims", "render", "provenance"],
      "properties": {
        "type": {"const": "TermDefinition"}, "spec": {"$ref": "#/$defs/Spec"},
        "id": {"type": "string", "pattern": "^UP:[A-Za-z0-9-]+$"}, "title": {"type": "string"},
        "params": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false,
          "required": ["type", "doc"], "properties": {"type": {"type": "string"}, "doc": {"type": "string"}}},
          "description": "No 'default' is possible: each declaration may hold only type and doc (axiom A6)."},
        "forms": {"type": "array", "items": {"$ref": "#/$defs/ClauseForm"}},
        "claims": {"type": "object", "propertyNames": {"$ref": "#/$defs/ClaimType"},
          "additionalProperties": {"type": "object", "required": ["data", "doc"], "properties": {"data": {"type": "object"}, "doc": {"type": "string"}}}},
        "render": {"type": "string"},
        "provenance": {"type": "object", "additionalProperties": false, "required": ["drafted_by", "reviewed_by"],
          "properties": {"drafted_by": {"type": "string"},
            "reviewed_by": {"type": "array", "items": {"type": "object", "required": ["segment", "reviewer", "date"],
              "properties": {"segment": {"enum": ["aggregator", "supplier", "member"]}, "reviewer": {"type": "string"}, "date": {"$ref": "#/$defs/Time"}}}},
            "supersedes": {"$ref": "#/$defs/Hash"}, "change_note": {"type": "string"}}}}},
    "Clause": {"type": "object", "additionalProperties": false, "required": ["n", "term", "def", "params"],
      "properties": {"n": {"type": "string", "minLength": 1}, "term": {"type": "string", "pattern": "^UP:[A-Za-z0-9-]+$"},
        "def": {"$ref": "#/$defs/Hash"}, "params": {"type": "object"},
        "over": {"type": "array", "items": {"type": "string"}}}},
    "Agreement": {"type": "object", "additionalProperties": false, "required": ["type", "spec", "parties", "clauses"],
      "properties": {"type": {"const": "Agreement"}, "spec": {"$ref": "#/$defs/Spec"},
        "parties": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["role", "party"], "properties": {"role": {"$ref": "#/$defs/Role"}, "party": {"$ref": "#/$defs/Party"}}}},
        "clauses": {"type": "array", "items": {"$ref": "#/$defs/Clause"}}, "label": {"type": "string"}}},
    "Claim": {"type": "object", "additionalProperties": false, "required": ["type", "clause", "data"],
      "properties": {"type": {"$ref": "#/$defs/ClaimType"}, "clause": {"type": "string"}, "data": {"type": "object"}}},
    "Event": {"type": "object", "additionalProperties": false, "required": ["type", "spec", "kind", "at", "by", "body", "sigs"],
      "properties": {"type": {"const": "Event"}, "spec": {"$ref": "#/$defs/Spec"},
        "kind": {"enum": ["propose", "accept", "attest"]},
        "chain": {"$ref": "#/$defs/ChainId"}, "prev": {"$ref": "#/$defs/Hash"},
        "at": {"$ref": "#/$defs/Time"}, "by": {"$ref": "#/$defs/PublicKey"},
        "body": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["agreement"],
            "properties": {"agreement": {"$ref": "#/$defs/Agreement"}, "supersedes": {"$ref": "#/$defs/Hash"}, "expires": {"$ref": "#/$defs/Time"}}},
          {"type": "object", "additionalProperties": false, "required": ["target"], "properties": {"target": {"$ref": "#/$defs/Hash"}}},
          {"type": "object", "additionalProperties": false, "required": ["claim"], "properties": {"claim": {"$ref": "#/$defs/Claim"}}}]},
        "sigs": {"$ref": "#/$defs/Sigs"}}},
    "Ack": {"type": "object", "additionalProperties": false, "required": ["by", "at", "event"],
      "properties": {"by": {"$ref": "#/$defs/PublicKey"}, "at": {"$ref": "#/$defs/Time"}, "event": {"$ref": "#/$defs/Hash"}}},
    "State": {"type": "object", "additionalProperties": false,
      "required": ["type", "spec", "chain", "height", "last", "at", "status", "agreement", "facts"],
      "properties": {"type": {"const": "State"}, "spec": {"$ref": "#/$defs/Spec"}, "chain": {"$ref": "#/$defs/ChainId"},
        "height": {"type": "integer", "minimum": 1}, "last": {"$ref": "#/$defs/Hash"}, "at": {"$ref": "#/$defs/Time"},
        "status": {"enum": ["proposed", "executed"]}, "agreement": {"$ref": "#/$defs/Hash"},
        "executed_at": {"$ref": "#/$defs/Time"}, "ends_at": {"$ref": "#/$defs/Time"},
        "pending": {"type": "object", "additionalProperties": false, "required": ["event", "agreement", "signed"],
          "properties": {"event": {"$ref": "#/$defs/Hash"}, "agreement": {"$ref": "#/$defs/Hash"},
            "signed": {"type": "array", "items": {"$ref": "#/$defs/PublicKey"}}, "expires": {"$ref": "#/$defs/Time"}}},
        "facts": {"type": "object", "additionalProperties": {"type": "object", "required": ["claims"],
          "properties": {"claims": {"type": "array", "items": {"type": "object", "additionalProperties": false,
            "required": ["event", "type", "by", "at", "data", "acks"],
            "properties": {"event": {"$ref": "#/$defs/Hash"}, "type": {"$ref": "#/$defs/ClaimType"}, "by": {"$ref": "#/$defs/PublicKey"},
              "at": {"$ref": "#/$defs/Time"}, "data": {"type": "object"}, "acks": {"type": "array", "items": {"$ref": "#/$defs/Ack"}}}}}}}}}},
    "Bound": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["any"], "properties": {"any": {"const": true}}},
      {"type": "object", "additionalProperties": false, "required": ["in"], "properties": {"in": {"type": "array"}}},
      {"type": "object", "additionalProperties": false, "minProperties": 1,
        "properties": {"min": {"oneOf": [{"$ref": "#/$defs/Decimal"}, {"$ref": "#/$defs/Amount"}]}, "max": {"oneOf": [{"$ref": "#/$defs/Decimal"}, {"$ref": "#/$defs/Amount"}]}}},
      {"type": "object", "additionalProperties": false, "required": ["max_period"], "properties": {"max_period": {"$ref": "#/$defs/Period"}}}]},
    "Mandate": {"type": "object", "additionalProperties": false, "required": ["type", "spec", "principal", "agent", "not_before", "expires", "scope", "sigs"],
      "properties": {"type": {"const": "Mandate"}, "spec": {"$ref": "#/$defs/Spec"},
        "principal": {"$ref": "#/$defs/PublicKey"}, "agent": {"$ref": "#/$defs/PublicKey"},
        "not_before": {"$ref": "#/$defs/Time"}, "expires": {"$ref": "#/$defs/Time"},
        "scope": {"type": "object", "additionalProperties": false, "required": ["kinds", "roles"],
          "properties": {"kinds": {"type": "array", "items": {"enum": ["propose", "accept", "attest"]}},
            "roles": {"type": "array", "items": {"$ref": "#/$defs/Role"}},
            "chains": {"type": "array", "items": {"$ref": "#/$defs/ChainId"}},
            "terms": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/Bound"}}},
            "claims": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/Bound"}}}}},
        "sigs": {"$ref": "#/$defs/Sigs"}}},
    "Commitment": {"type": "object", "required": ["clause", "duty", "obligor", "obligee", "period", "due", "status"],
      "properties": {"chain": {"$ref": "#/$defs/ChainId"}, "clause": {"type": "string"}, "duty": {"type": "string"},
        "obligor": {"type": "object", "required": ["role", "key"]}, "obligee": {"type": "object", "required": ["role", "key"]},
        "period": {"type": "object", "required": ["start", "end"]}, "due": {"$ref": "#/$defs/Time"},
        "amount": {"oneOf": [{"$ref": "#/$defs/Amount"}, {"type": "string"}]},
        "status": {"enum": ["open", "discharged", "overdue", "sealed"]}}},
    "Bundle": {"type": "object", "additionalProperties": false, "required": ["type", "spec", "terms", "chains"],
      "properties": {"type": {"const": "Bundle"}, "spec": {"$ref": "#/$defs/Spec"},
        "terms": {"type": "array", "items": {"$ref": "#/$defs/TermDefinition"}},
        "mandates": {"type": "array", "items": {"$ref": "#/$defs/Mandate"}},
        "chains": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Event"}}},
        "disclosures": {"type": "array", "items": {"$ref": "#/$defs/Disclosure"}}}}
  }
}
